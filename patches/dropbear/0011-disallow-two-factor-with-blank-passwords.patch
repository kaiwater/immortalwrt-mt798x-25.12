From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matt Johnston <matt@ucc.asn.au>
Date: Tue, 16 Jun 2026 10:21:05 +0800
Subject: [PATCH] Disallow -t (two factor) with -B (blank passwords)

The blank password option took precedence, the options don't really make
sense together.
---
 src/svr-runopts.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/svr-runopts.c b/src/svr-runopts.c
index 8034c50c..35cc33f0 100644
--- a/src/svr-runopts.c
+++ b/src/svr-runopts.c
@@ -468,6 +468,9 @@ void svr_getopts(int argc, char ** argv) {
 	if (svr_opts.multiauthmethod && svr_opts.noauthpass) {
 		dropbear_exit("-t and -s are incompatible");
 	}
+	if (svr_opts.multiauthmethod && svr_opts.allowblankpass) {
+		dropbear_exit("-t and -B are incompatible");
+	}
 
 	if (strlen(svr_opts.authorized_keys_dir) == 0) {
 		dropbear_exit("Bad -D");
